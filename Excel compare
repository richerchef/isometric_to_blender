import pandas as pd
import numpy as np
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.metrics.pairwise import cosine_similarity

# ===============================
# 1. LOAD FILES
# ===============================

file1 = "file1.xlsx"
file2 = "file2.xlsx"

df1 = pd.read_excel(file1)
df2 = pd.read_excel(file2)

# ===============================
# 2. CONVERT EACH CELL TO RECORD WITH LOCATION
# ===============================

def extract_cells(df, sheet_name):
    records = []
    for row_idx in range(df.shape[0]):
        for col_idx in range(df.shape[1]):
            value = df.iat[row_idx, col_idx]
            
            if pd.notna(value):
                text = str(value).strip().lower()
                if text != "":
                    records.append({
                        "sheet": sheet_name,
                        "row": row_idx + 2,  # +2 accounts for Excel header row
                        "column": df.columns[col_idx],
                        "value": text
                    })
    return pd.DataFrame(records)

cells1 = extract_cells(df1, "Sheet1")
cells2 = extract_cells(df2, "Sheet2")

print("Cells in Sheet1:", len(cells1))
print("Cells in Sheet2:", len(cells2))

# ===============================
# 3. EXACT MATCHES WITH LOCATION
# ===============================

exact_matches = pd.merge(
    cells1,
    cells2,
    on="value",
    suffixes=("_sheet1", "_sheet2")
)

print("Exact matches found:", len(exact_matches))

# ===============================
# 4. SIMILARITY MATCHING
# ===============================

# Remove duplicates by value to reduce comparison size
unique1 = cells1.drop_duplicates(subset=["value"]).reset_index(drop=True)
unique2 = cells2.drop_duplicates(subset=["value"]).reset_index(drop=True)

combined = unique1["value"].tolist() + unique2["value"].tolist()

vectorizer = TfidfVectorizer().fit(combined)
tfidf = vectorizer.transform(combined)

tfidf_1 = tfidf[:len(unique1)]
tfidf_2 = tfidf[len(unique1):]

similarity_matrix = cosine_similarity(tfidf_1, tfidf_2)

threshold = 0.8  # adjust here

similar_results = []

for i in range(similarity_matrix.shape[0]):
    for j in range(similarity_matrix.shape[1]):
        score = similarity_matrix[i, j]
        if score >= threshold:
            similar_results.append({
                "sheet1_row": unique1.iloc[i]["row"],
                "sheet1_column": unique1.iloc[i]["column"],
                "sheet1_value": unique1.iloc[i]["value"],
                "sheet2_row": unique2.iloc[j]["row"],
                "sheet2_column": unique2.iloc[j]["column"],
                "sheet2_value": unique2.iloc[j]["value"],
                "similarity_score": round(float(score), 3)
            })

similar_df = pd.DataFrame(similar_results).sort_values(
    "similarity_score", ascending=False
)

print("Similar matches found:", len(similar_df))

# ===============================
# 5. EXPORT RESULTS
# ===============================

output_file = "comparison_results_with_locations.xlsx"

with pd.ExcelWriter(output_file) as writer:
    exact_matches.to_excel(writer, sheet_name="Exact Matches", index=False)
    similar_df.to_excel(writer, sheet_name="Similar Matches", index=False)

print("Done. Results saved to:", output_file)
